# ==========================================
# CinePulse Environment Configuration
# ==========================================

# OMDB API Configuration
# Get a free API key at: https://www.omdbapi.com/apikey.aspx
# (A public demo fallback key is included in code if left blank)
VITE_OMDB_API_KEY=b9a5e69d

# Firebase Configuration (Optional)
# Create a free Firebase project at: https://console.firebase.google.com/
# Enable "Authentication" (Email/Password) and "Realtime Database"
# If left empty, CinePulse automatically runs in resilient Local Simulation Mode!
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
